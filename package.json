{
  "name": "dfwlfront-7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:ledger": "esbuild scripts/test-ledger.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-ledger.mjs && node node_modules/.cache/test-ledger.mjs",
    "test:smoke": "esbuild scripts/ssr-smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ssr-smoke.mjs --external:vite --external:vue --external:vue/server-renderer --external:pinia --external:element-plus && node node_modules/.cache/ssr-smoke.mjs 2>/dev/null",
    "test": "npm run test:ledger && npm run test:smoke"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.7",
    "leaflet": "^1.9.4",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
